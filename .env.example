# Copie este arquivo para ".env" e preencha. O ".env" real fica fora do Git (.gitignore).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/scheduling
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=troque-por-uma-senha
# A chave do JWT precisa ter no mínimo 32 caracteres
JWT_SECRET=troque-por-um-valor-aleatorio-com-mais-de-32-caracteres
# Administrador criado na primeira execução (se ficarem vazios, nenhum admin é criado)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte